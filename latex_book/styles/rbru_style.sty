\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{styles/rbru_style}[2026/09/11 RBRU Academic Formatter & Masterclass Textbook Style]

% ==============================================================================
% 1. การตั้งค่าหน้ากระดาษตามระเบียบ มรภ.รำไพพรรณี (Margins)
% ==============================================================================
% กั้นบน 1.5 นิ้ว, กั้นซ้าย 1.5 นิ้ว, กั้นล่าง 1.0 นิ้ว, กั้นขวา 1.0 นิ้ว
\RequirePackage[
    a4paper,
    top=1.5in,
    left=1.5in,
    bottom=1.0in,
    right=1.0in,
    headheight=28pt,
    headsep=18pt,
    footskip=25pt
]{geometry}

% ==============================================================================
% 2. ฟอนต์ภาษาไทยและยูนิโค้ด (XeLaTeX Font Settings)
% ==============================================================================
\RequirePackage{fontspec}
\RequirePackage{xunicode}
\RequirePackage{xltxtra}

% เลือกระหว่าง TH Sarabun New หรือ Sarabun ที่มีในระบบ
\defaultfontfeatures{Mapping=tex-text, Scale=1.0}
\setmainfont{Sarabun}
\setsansfont{Sarabun}
\setmonofont{Courier New}[Scale=0.92]

% การตัดคำภาษาไทยและป้องกัน Orphan Lines
\XeTeXlinebreaklocale "th_TH"
\XeTeXlinebreakskip = 0pt plus 2pt minus 0.5pt
\setlength{\emergencystretch}{2.5em}

\clubpenalty=10000
\widowpenalty=10000
\displaywidowpenalty=10000

% ==============================================================================
% 3. การย่อหน้าและระยะห่างบรรทัด (Hierarchical Indentation)
% ==============================================================================
\RequirePackage{indentfirst}
\setlength{\parindent}{1.25cm} % 1 Tab = 1.25 cm ตามระเบียบ มรภ.รำไพพรรณี
\setlength{\parskip}{4pt plus 1pt minus 1pt}
\linespread{1.18} % ระยะห่างระหว่างบรรทัดให้อ่านง่าย สบายตา

\RequirePackage{needspace}
\RequirePackage[section]{placeins}
\RequirePackage{enumitem}

% ==============================================================================
% 4. จานสีมาตรฐานสถาบันและธีมวิชาการเกษตร (Color Palette)
% ==============================================================================
\RequirePackage{xcolor}
\definecolor{rbruNavy}{HTML}{0D233A}      % น้ำเงินราชภัฏรำไพพรรณี
\definecolor{rbruGold}{HTML}{D4AF37}      % ทองอร่ามสมเด็จพระนางเจ้ารำไพพรรณี
\definecolor{rbruSlate}{HTML}{2C3E50}     % ศิลาคลาสสิก
\definecolor{agriGreen}{HTML}{1B5E20}     % เขียวป่าไม้เกษตรกรรม
\definecolor{agriLeaf}{HTML}{2E7D32}      % เขียวใบไม้สด
\definecolor{agriEarth}{HTML}{4E342E}     % น้ำตาลดินปฐพีวิทยา
\definecolor{agriBlue}{HTML}{0277BD}      % ฟ้าสายน้ำ
\definecolor{agriRed}{HTML}{C62828}       % แดงแจ้งเตือน
\definecolor{agriBg}{HTML}{F8FAFC}        % เทาขาวนวล
\definecolor{agriCodeBg}{HTML}{0F172A}    % น้ำเงินดำเข้มสำหรับโค้ด

% ==============================================================================
% 5. แพ็กเกจคณิตศาสตร์ ตาราง และกราฟิก
% ==============================================================================
\RequirePackage{amsmath,amssymb,amsfonts,mathtools}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{shapes,arrows,positioning,calc,shadows,fadings}
\tikzset{every node/.style={font=\normalfont}}
\RequirePackage[many]{tcolorbox}
\tcbuselibrary{listings,skins,breakable}

% สไตล์คอลัมน์ตารางแบบข้อความภาษาไทยจัดชิดซ้าย
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
\newcolumntype{C}{>{\centering\arraybackslash}X}

% ==============================================================================
% 6. รูปแบบคำบรรยายภาพและตาราง (Caption Typography)
% ==============================================================================
\RequirePackage{caption}
\DeclareCaptionLabelSeparator{thaisep}{\quad}
\captionsetup{labelsep=thaisep}

% กำหนดชื่อเรียกรูปภาพและตารางเป็นภาษาไทยตามระเบียบ มรภ.รำไพพรรณี (ป้องกันการแยกคำด้วย \mbox)
\renewcommand{\figurename}{\mbox{ภาพที่}}
\renewcommand{\tablename}{\mbox{ตารางที่}}

\AtBeginDocument{
    \gdef\figurename{\mbox{ภาพที่}}
    \gdef\tablename{\mbox{ตารางที่}}
    \captionsetup[figure]{name={\mbox{ภาพที่}}}
    \captionsetup[table]{name={\mbox{ตารางที่}}}
}

% คำบรรยายตาราง: อยู่ด้านบน และจัดชิดขอบขวาเสมอ (Flush Right)
\captionsetup[table]{
    name={\mbox{ตารางที่}},
    position=top,
    skip=6pt,
    labelfont={bf,color=rbruNavy},
    textfont={normalfont},
    labelsep=thaisep,
    justification=raggedleft,
    singlelinecheck=false
}

% คำบรรยายภาพ: อยู่ด้านล่าง จัดกึ่งกลาง
\captionsetup[figure]{
    name={\mbox{ภาพที่}},
    position=bottom,
    skip=8pt,
    labelfont={bf,color=rbruNavy},
    textfont={normalfont},
    labelsep=thaisep
}

% ==============================================================================
% 7. หัวกระดาษและท้ายกระดาษวิ่ง (Running Headers without Trailing Dot)
% ==============================================================================
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}

% ตัดเครื่องหมายจุด (.) ออกจาก \chaptermark อย่างเคร่งครัด
\renewcommand{\chaptermark}[1]{%
    \markboth{%
        \ifnum \c@secnumdepth >\m@ne
            \if@mainmatter
                บทที่\ \thechapter\quad
            \fi
        \fi
        #1%
    }{}%
}

\fancyhead[LE]{\small\bfseries\color{rbruNavy} \thepage \quad \textbar \quad JC -AgriTech + AI: เกษตรอัจฉริยะและการเรียนรู้เชิงลึก}
\fancyhead[RO]{\small\bfseries\color{rbruNavy} \leftmark \quad \textbar \quad \thepage}
\fancyfoot[C]{\small\color{gray} มหาวิทยาลัยราชภัฏรำไพพรรณี}
\renewcommand{\headrulewidth}{0.6pt}
\renewcommand{\footrulewidth}{0pt}

% ==============================================================================
% 8. กล่องวิชาการมาตรฐาน (Academic Custom Boxes)
% ==============================================================================
% กล่องความรู้เทคโนโลยีเกษตร (Agri Box)
\newtcolorbox{agribox}[2][]{
    enhanced,
    breakable,
    colback=white,
    colframe=agriGreen,
    fonttitle=\bfseries\color{white},
    coltitle=white,
    colbacktitle=agriGreen,
    title={#2},
    arc=2mm,
    boxrule=1pt,
    leftrule=4mm,
    top=6pt, bottom=6pt, left=10pt, right=10pt,
    drop shadow=black!8,
    before skip=10pt,
    after skip=10pt,
    #1
}

% กล่องนิยามและทฤษฎีทางปฐพีวิทยา (Definition Box)
\newtcolorbox{definitionbox}[2][]{
    enhanced,
    breakable,
    colback=agriBg,
    colframe=rbruNavy,
    fonttitle=\bfseries\color{white},
    coltitle=white,
    colbacktitle=rbruNavy,
    title={#2},
    arc=2mm,
    boxrule=0.8pt,
    leftrule=4mm,
    top=6pt, bottom=6pt, left=10pt, right=10pt,
    before skip=10pt,
    after skip=10pt,
    #1
}

% กล่องวิเคราะห์และคำนวณ (Worked Example Box)
\newtcolorbox{workedbox}[2][]{
    enhanced,
    breakable,
    colback=white,
    colframe=rbruGold!90!black,
    fonttitle=\bfseries\color{white},
    coltitle=white,
    colbacktitle=rbruGold!90!black,
    title={#2},
    arc=2mm,
    boxrule=1pt,
    leftrule=4mm,
    top=6pt, bottom=6pt, left=10pt, right=10pt,
    drop shadow=black!6,
    before skip=10pt,
    after skip=10pt,
    #1
}

% กล่องบันทึกพรอมพ์และการสื่อสารกับ AI (Prompt Box)
\newtcolorbox{promptbox}[2][]{
    enhanced,
    breakable,
    colback=agriBg!40!white,
    colframe=agriBlue,
    fonttitle=\bfseries\color{white},
    coltitle=white,
    colbacktitle=agriBlue,
    title={#2},
    arc=2mm,
    boxrule=1pt,
    leftrule=4.5mm,
    top=6pt, bottom=6pt, left=10pt, right=10pt,
    drop shadow=black!6,
    before skip=10pt,
    after skip=10pt,
    #1
}

% กล่องโค้ดภาษา Python สำหรับ AI (Python Listing Box)
\newtcblisting{pythonbox}[1][การเขียนโปรแกรมด้วย Python]{
    enhanced,
    breakable,
    colback=agriCodeBg,
    colframe=rbruNavy,
    coltext=white,
    fonttitle=\bfseries\color{white},
    colbacktitle=rbruNavy,
    title={#1},
    arc=2mm,
    boxrule=1pt,
    top=6pt, bottom=6pt, left=10pt, right=10pt,
    listing only,
    listing options={
        language=Python,
        basicstyle=\ttfamily\small\color{white},
        keywordstyle=\color{cyan}\bfseries,
        stringstyle=\color{yellow!80!white},
        commentstyle=\color{green!60!white}\itshape,
        numbers=left,
        numberstyle=\tiny\color{gray},
        numbersep=8pt,
        showstringspaces=false,
        tabsize=4,
        breaklines=true
    },
    before skip=10pt,
    after skip=10pt
}

% กล่องโค้ดภาษา C++ สำหรับเฟิร์มแวร์และ TinyML (C++ Listing Box)
\newtcblisting{cppbox}[1][การพัฒนาเฟิร์มแวร์ C++]{
    enhanced,
    breakable,
    colback=agriCodeBg,
    colframe=rbruNavy,
    coltext=white,
    fonttitle=\bfseries\color{white},
    colbacktitle=rbruNavy,
    title={#1},
    arc=2mm,
    boxrule=1pt,
    top=6pt, bottom=6pt, left=10pt, right=10pt,
    listing only,
    listing options={
        language=C++,
        basicstyle=\ttfamily\small\color{white},
        keywordstyle=\color{cyan}\bfseries,
        stringstyle=\color{yellow!80!white},
        commentstyle=\color{green!60!white}\itshape,
        numbers=left,
        numberstyle=\tiny\color{gray},
        numbersep=8pt,
        showstringspaces=false,
        tabsize=4,
        breaklines=true
    },
    before skip=10pt,
    after skip=10pt
}

% ==============================================================================
% 9. แบนเนอร์หัวบทวิชาการหรูหรา (Academic Chapter Banner Box)
% ==============================================================================
\RequirePackage{titlesec}

\newcommand{\rbruchapterbanner}[1]{%
    \begin{tcolorbox}[
        enhanced,
        width=\textwidth,
        colback=rbruNavy,
        colframe=rbruNavy,
        arc=2.5mm,
        boxrule=0pt,
        borderline east={4.5pt}{0pt}{rbruGold},
        interior style={left color=rbruNavy!98!black, right color=rbruSlate!90!black},
        top=14pt, bottom=14pt, left=14pt, right=14pt,
        shadow={1.5mm}{-1.5mm}{0mm}{black!15}
    ]
        \raggedleft % ชิดขวาตามมาตรฐานเลย์เอาต์สากล
        {\fontsize{38}{44}\selectfont\bfseries\color{white} บทที่\ \thechapter\par}
        \vspace{4pt}
        {\color{rbruGold}\rule{0.50\textwidth}{2pt}\par}
        \vspace{6pt}
        {\fontsize{24}{30}\selectfont\bfseries\color{white} #1\par}
    \end{tcolorbox}
}

\newcommand{\rbruunnumberedchapterbanner}[1]{%
    \begin{tcolorbox}[
        enhanced,
        width=\textwidth,
        colback=rbruNavy,
        colframe=rbruNavy,
        arc=2.5mm,
        boxrule=0pt,
        borderline east={4.5pt}{0pt}{rbruGold},
        interior style={left color=rbruNavy!98!black, right color=rbruSlate!90!black},
        top=12pt, bottom=12pt, left=14pt, right=14pt,
        shadow={1.5mm}{-1.5mm}{0mm}{black!15}
    ]
        \raggedleft
        {\fontsize{26}{32}\selectfont\bfseries\color{white} #1\par}
    \end{tcolorbox}
}

\newcommand{\rbruappendixbanner}[1]{%
    \begin{tcolorbox}[
        enhanced,
        width=\textwidth,
        colback=rbruNavy,
        colframe=rbruNavy,
        arc=2.5mm,
        boxrule=0pt,
        borderline east={4.5pt}{0pt}{rbruGold},
        interior style={left color=rbruNavy!98!black, right color=rbruSlate!90!black},
        top=14pt, bottom=14pt, left=14pt, right=14pt,
        shadow={1.5mm}{-1.5mm}{0mm}{black!15}
    ]
        \raggedleft
        {\fontsize{34}{40}\selectfont\bfseries\color{white} ภาคผนวก\ \thechapter\par}
        \vspace{4pt}
        {\color{rbruGold}\rule{0.50\textwidth}{2pt}\par}
        \vspace{6pt}
        {\fontsize{22}{28}\selectfont\bfseries\color{white} #1\par}
    \end{tcolorbox}
}

\titleformat{\chapter}[block]{\normalfont}{}{0pt}{\rbruchapterbanner}
\titleformat{name=\chapter,numberless}[block]{\normalfont}{}{0pt}{\rbruunnumberedchapterbanner}
\titlespacing*{\chapter}{0pt}{0pt}{20pt}

% ปรับรูปแบบหัวบทเมื่อเข้าสู่ภาคผนวก (Appendix Hook)
\let\rbruorigappendix\appendix
\renewcommand{\appendix}{%
    \rbruorigappendix
    \titleformat{\chapter}[block]{\normalfont}{}{0pt}{\rbruappendixbanner}
    \renewcommand{\chaptermark}[1]{%
        \markboth{ภาคผนวก\ \thechapter\quad ##1}{}%
    }
}

% ลำดับชั้นหัวข้อหลักและหัวข้อย่อย (Section / Subsection)
\titleformat{\section}
    {\normalfont\fontsize{18}{22}\selectfont\bfseries\color{rbruNavy}}
    {\thesection\quad}
    {0pt}
    {}
\titlespacing*{\section}{0pt}{16pt plus 3pt minus 2pt}{8pt plus 2pt minus 1pt}

\titleformat{\subsection}
    {\normalfont\fontsize{16}{20}\selectfont\bfseries\color{agriGreen}}
    {\thesubsection\quad}
    {0pt}
    {}
\titlespacing*{\subsection}{1.25cm}{14pt plus 3pt minus 2pt}{6pt plus 2pt minus 1pt}

% ควบคุม Indent อัตโนมัติตามระดับหัวข้อ
\let\rbruorigchapter\chapter
\renewcommand{\chapter}{\global\setlength{\parindent}{1.25cm}\rbruorigchapter}

\let\rbruorigsection\section
\renewcommand{\section}{\Needspace*{8\baselineskip}\global\setlength{\parindent}{1.25cm}\rbruorigsection}

\let\rbruorigsubsection\subsection
\renewcommand{\subsection}{\Needspace*{5\baselineskip}\global\setlength{\parindent}{2.50cm}\rbruorigsubsection}

% ==============================================================================
% 10. ระบบดัชนีสืบค้นและไฮเปอร์ลิงก์ (Index & Hyperlinks)
% ==============================================================================
\RequirePackage{imakeidx}
\makeindex[columns=2, title=ดัชนีสืบค้นคำสำคัญ, intoc]

\RequirePackage[
    colorlinks=true,
    linkcolor=rbruNavy,
    citecolor=agriGreen,
    urlcolor=agriBlue,
    bookmarksnumbered=true,
    pdfstartview=FitH
]{hyperref}
